# Copy to .env and fill in. .env and secrets/ are gitignored.

# Google Earth Engine: Cloud project ID registered for Earth Engine (required)
EE_PROJECT=your-gcp-project-id

# Option A (interactive OAuth): leave this blank and run `earthengine authenticate` once.
# Option B (service account): drop the JSON key at secrets/ee-sa.json and point here.
#GOOGLE_APPLICATION_CREDENTIALS=secrets/ee-sa.json

# NASA Earthdata (only once the ECOSTRESS/AppEEARS backend exists)
#EARTHDATA_TOKEN=

# Hugging Face (only to download TabPFN weights)
#HF_TOKEN=

# EPA Clean Air Markets API key (https://api.data.gov/signup/)
#EPA_API_KEY=
